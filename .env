# HTTP server
PORT=3000
HOST=0.0.0.0
DISABLE_SVG=false

# Persistent QQ -> player-name cache
QQ_NAME_CACHE_FILE=data/qq-name-cache.json

# QQ Official Bot
# Set to true after filling in the credentials below.

# Public HTTPS URL reachable by QQ servers for card image transfer.
# Required for /card when using QQ group rich-media upload.
QQ_BOT_PUBLIC_BASE_URL=https://your-public-domain.example.com
QQ_BOT_STYLE=modern
QQ_BOT_PANEL_GROUPS_FILE=data/qq-panel-groups.json
QQ_BOT_ENABLED=false
QQ_BOT_APPID=
QQ_BOT_SECRET=
QQ_BOT_COMMAND_PREFIX=/
